                "d5Pin": -1,
                "d6Pin": -1,
                "d7Pin": -1,
                "d8Pin": -1,
                "d9Pin": -1,
                "dcPin": 14,
                "doubleBuffer": false,
                "initSequence": "# PicoCalc panel: an ST7365P (Sitronix, ST7796 family), started as ClockworkPi's\n# PicoMite does on the PicoCalc (PicoMite.patch, InitDisplaySPI). The ILI9488 list in\n# their lcdspi.c example left a slowly fading ghost of the screen before.\n# Inversion, pixel format and MADCTL are sent by the driver after this.\nF0 C3                  # command set: part I unlocked\nF0 96                  # command set: part II unlocked\nB4 00                  # display inversion: column\nB7 C6                  # entry mode\nB9 02 E0               # gate voltages\nC0 80 06               # power control 1\nC1 15                  # power control 2\nC2 A7                  # power control 3\nC5 04                  # VCOM\nE8 40 8A 00 00 29 19 AA 33   # display output timing\nE0 F0 06 0F 05 04 20 37 33 4C 37 13 14 2B 31   # positive gamma\nE1 F0 11 1B 11 0F 0A 37 43 4C 37 13 13 2C 32   # negative gamma\nF0 3C                  # command set: part I locked\nF0 69                  # command set: part II locked\n11; delay 120          # SLPOUT\n29; delay 20           # DISPON\n",
                "invertColor": true,
                "memoryHeight": 480,
                "memoryWidth": 320,
                "offsetX": 0,
                "offsetY": 0,
                "panelHeight": 320,
                "panelWidth": 320,
                "parallelWriteHz": 20000000,
                "rdPin": -1,
                "readsOnMosi": false,
                "rgbOrder": false,
                "rotation": "Portrait180Mirror",
                "rstPin": 15,
                "scanlineSync": false,
                "spiHost": 1,
                "spiReadHz": 6000000,
                "spiWriteHz": 62500000,
                "swapBytes": false,
                "tePin": -1,
                "usePsram": false,
                "wrPin": -1
              },
              "type": "DekiDisplay::DisplayPanelComponent"
            }
          ],
          "id": 702,
          "name": "Display (ST7365P 320x320, 16-bit)",
